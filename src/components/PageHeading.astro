---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="page-heading">
  <div class="container heading-inner">
    <slot />
    <h1>{title}</h1>
  </div>
</header>

<style>
  .page-heading {
    background: var(--slate);
    color: white;
    box-shadow: var(--box-shadow);
  }
  .heading-inner {
    padding: 2em 1em;
  }
  h1 {
    border-bottom: 2px solid white;
    padding-bottom: 0.35em;
  }
</style>
