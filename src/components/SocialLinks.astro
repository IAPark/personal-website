---
import type { CollectionEntry } from 'astro:content';

type Props = {
  socials: CollectionEntry<'resume'>['data']['socials'];
};

const { socials } = Astro.props;
const socialLinks = [
  {
    className: 'github',
    href: socials.github,
    ariaLabel: 'GitHub',
    svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.477 2 2 6.484 2 12.021c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.482 0-.237-.009-.866-.014-1.699-2.782.605-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.004.07 1.532 1.032 1.532 1.032.892 1.529 2.341 1.087 2.91.831.091-.646.35-1.087.636-1.337-2.221-.253-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 22 12c0-4.42-3.58-8-8-8z"/></svg>',
  },
  {
    className: 'linkedin',
    href: socials.linkedin,
    ariaLabel: 'LinkedIn',
    svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.602 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124Zm1.778 13.019H3.558V9h3.557v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/></svg>',
  },
  {
    className: 'bluesky',
    href: socials.bluesky,
    ariaLabel: 'Bluesky',
    svg: '<svg viewBox="0 0 64 57" aria-hidden="true"><path fill="currentColor" d="M13.873 3.805C21.21 9.332 29.103 20.537 32 26.55v15.882c0-.338-.13.044-.41.867-1.512 4.456-7.418 21.847-20.923 7.944-7.111-7.32-3.819-14.64 9.125-16.85-7.405 1.264-15.73-.825-18.014-9.015C1.12 23.022 0 8.51 0 6.55 0-3.268 8.579-.182 13.873 3.805ZM50.127 3.805C42.79 9.332 34.897 20.537 32 26.55v15.882c0-.338.13.044.41.867 1.512 4.456 7.418 21.847 20.923 7.944 7.111-7.32 3.819-14.64-9.125-16.85 7.405 1.264 15.73-.825 18.014-9.015C62.88 23.022 64 8.51 64 6.55c0-9.818-8.578-6.732-13.873-2.745Z"/></svg>',
  },
  {
    className: 'resume',
    href: socials.resume,
    ariaLabel: 'Resume',
    svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 2h8l6 6v14H6V2Zm7 1.5V9h5.5L13 3.5ZM8 11h8v2H8v-2Zm0 4h8v2H8v-2Zm0 4h5v2H8v-2Z"/></svg>',
  },
];
---

<div class="social-links">
  {socialLinks.map((social) => (
    <a
      class={social.className}
      href={social.href}
      target="_blank"
      rel="noreferrer"
      aria-label={social.ariaLabel}
      set:html={social.svg}
    />
  ))}
</div>

<style>
  .social-links { display: flex; gap: 6px; }
  .social-links a {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: white;
    box-shadow: 0 5px 10px rgba(0, 0, 0, 0.25);
    transition: transform 0.12s;
  }
  .social-links a:hover { transform: translateY(-2px); }
  .social-links :global(svg) { width: 22px; height: 22px; }
  .social-links .bluesky :global(svg) { width: 22px; height: 20px; }
  .github { background: #24292e; }
  .linkedin { background: #0084bf; }
  .bluesky { background: #1185fe; }
  .resume { background: #334344; }
</style>
